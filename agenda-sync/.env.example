# --- GoHighLevel (subconta Janaúba) ---
# Token de Integração Privada: Configurações > Integrações Privadas > Criar
# Escopos: calendars.readonly, calendars.write, calendars/events.readonly,
#          calendars/events.write, contacts.readonly, contacts.write
GHL_TOKEN=
GHL_LOCATION_ID=j3PgGRcO91FQMdNKo3bD
GHL_CALENDAR_ID=          # rode `node index.js calendarios` para descobrir
# GHL_USER_ID=            # opcional: usuário do GHL responsável pelos compromissos

# --- Comportamento ---
CATEGORIAS=1,3,6,7        # categorias do DH que viram compromisso no GHL (avaliação, retorno, retorno c/ exames, reavaliação)
SESSOES=ignorar           # ignorar | bloquear (sessões de tratamento viram horário bloqueado no GHL)
GHL_PARA_DH=sim           # sim | nao — criar no DH o que for marcado no GHL
DIAS_FRENTE=28
TAGS_CONTATO=janauba,doutor-hernia-sync
